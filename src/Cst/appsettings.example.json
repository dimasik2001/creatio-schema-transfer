{
  // Copy to appsettings.json next to cst.exe. Passwords can be left empty and passed
  // via CST_PASSWORD_<ENV> (e.g. CST_PASSWORD_DEV) or CST_PASSWORD instead.
  // DbEngine (MSSql | PostgreSql | Oracle) is required to import into the environment:
  // only SQL scripts written for that engine are executed.
  "Environments": {
    "dev": {
      "Url": "http://localhost:8080",
      "Login": "Supervisor",
      "Password": "",
      "DbEngine": "MSSql",
      // Optional: Creatio installation root folder as seen from this machine (like clio's EnvironmentPath).
      // Needed only for the files: section of the transfer list.
      "Path": "D:\\inetpub\\creatio",
      "IsNetCore": null,
      "TimeoutMinutes": 30
    }
  }
}
